        <item>
            <title>0.6.55</title>
            <pubDate>Fri, 11 Sep 2026 13:56:38 -0400</pubDate>
            <link>https://github.com/templetongroup/Kiki/releases/tag/v0.6.55</link>
            <sparkle:version>88</sparkle:version>
