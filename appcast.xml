        <item>
            <title>0.4.5</title>
            <pubDate>Fri, 07 Aug 2026 14:55:00 -0400</pubDate>
            <link>https://github.com/templetongroup/Kiki/releases/tag/v0.4.5</link>
            <sparkle:version>13</sparkle:version>
