        <item>
            <title>0.4.3</title>
            <pubDate>Fri, 07 Aug 2026 13:55:15 -0400</pubDate>
            <link>https://github.com/templetongroup/Kiki/releases/tag/v0.4.3</link>
            <sparkle:version>11</sparkle:version>
