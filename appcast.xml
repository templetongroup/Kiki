        <item>
            <title>0.6.64</title>
            <pubDate>Sun, 20 Sep 2026 12:38:13 -0400</pubDate>
            <link>https://github.com/templetongroup/Kiki/releases/tag/v0.6.64</link>
            <sparkle:version>97</sparkle:version>
